# Copy to .env (git-ignored) or export in your shell / Colab Secrets. NEVER commit real values.
# Newer Aura instances use the INSTANCE ID as both username and database name.
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USERNAME=<instance-id>
NEO4J_PASSWORD=<your-password>
NEO4J_DATABASE=<instance-id>
